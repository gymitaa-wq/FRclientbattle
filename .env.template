# Environment Configuration for Project CAII
# Copy this file to .env and fill in your API keys

# ============================================================================
# LLM API KEYS (Choose at least one)
# ============================================================================

# Google Gemini (Recommended)
GOOGLE_API_KEY=your-google-api-key-here

# Anthropic Claude (Alternative)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI GPT (Alternative)
# OPENAI_API_KEY=your-openai-api-key-here


# ============================================================================
# DATABRICKS CONFIGURATION (Optional)
# ============================================================================

# If using Databricks serving endpoints
# DATABRICKS_SERVING_ENDPOINT=https://your-workspace.cloud.databricks.com/serving-endpoints
# DATABRICKS_TOKEN=your-databricks-token


# ============================================================================
# MLFLOW CONFIGURATION (Optional)
# ============================================================================

# MLflow tracking URI (defaults to local)
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_NAME=Project_CAII


# ============================================================================
# NOTES
# ============================================================================
# 
# 1. Never commit this file with real API keys to version control
# 2. Add .env to your .gitignore file
# 3. For Databricks deployment, use Databricks Secrets instead
#    Example: dbutils.secrets.get(scope="caii", key="google_api_key")
